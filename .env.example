# Bulk SEO Writer — environment (all OPTIONAL)
#
# With NO env set, the app runs in DEMO MODE: it serves pre-generated sample
# articles and the deterministic SEO scorer runs fully live. Zero config needed
# for a working public demo.
#
# Set these for LLM MODE (real article generation):

# Required for LLM mode. Any OpenAI-compatible key.
OPENAI_API_KEY=

# Optional. Point at any OpenAI-compatible endpoint (cloud OpenAI, local server,
# router). Leave unset to use api.openai.com. Example local: http://127.0.0.1:20128/v1
OPENAI_BASE_URL=

# Optional. Model id. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional. Max LLM articles per client IP per hour (LLM mode only). Default: 40
# In-memory, per server instance: also set a spending limit at your provider.
RATE_LIMIT_MAX=40
